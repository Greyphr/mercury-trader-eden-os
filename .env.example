# ──────────────────────────────────────────────────────────────
# Mercury Trader — Environment configuration (.env.example)
# Copy to `.env` and fill in real values. Never commit `.env`.
# All values here override `config/*.yaml` at runtime.
# ──────────────────────────────────────────────────────────────

# ── Deployment mode ────────────────────────────────────────────
# live      = execute real orders on MT5
# paper     = simulate fills locally (no broker order sent)
# read_only = collect data + reason, never trade
DEPLOYMENT_MODE=paper

# ── Environment profile ───────────────────────────────────────
# Which broker/symbol-map/database/logs to use (config/environments.yaml).
#   development    paper broker, synthetic data
#   metaquotes_demo  MT5 demo account, paper risk (forward test)
#   exness_live    Exness LIVE — REAL MONEY (trading_enabled must be true)
# Also overridable per-invocation with `mercury --env <name>`.
MERCURY_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────
# Defaults per environment (mercury_development / mercury_demo / mercury_live).
DATABASE_URL=

# ── MetaTrader 5 (Exness) ─────────────────────────────────────
# Generic (used by the `development` profile only if it had an MT5 backend):
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_ENABLE_TERMINAL_LAUNCH=true

# MetaQuotes-Demo profile credentials (metaquotes_demo):
MT5_LOGIN_DEMO=
MT5_PASSWORD_DEMO=

# Exness LIVE profile credentials (exness_live):
MT5_LOGIN_LIVE=
MT5_PASSWORD_LIVE=

# ── Hermes — LLM providers ────────────────────────────────────
# Pluggable. `provider=hybrid` uses local (Ollama) for fast
# pre-trade checks and external for heavy reasoning.
HERMES_LLM_PROVIDER=hybrid

# External (heavy reasoning) — OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (alternative external provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Local (fast pre-trade checks) — Ollama OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Local (deep/heavy reasoning) — LM Studio OpenAI-compatible endpoint
# Start LM Studio's local server first (Developer tab → Start Server),
# then set this to whatever model you have loaded there.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=

# Which provider `external.provider` resolves to at runtime, overriding
# config/providers.yaml — set to lm_studio to route Hermes's deep/post-trade
# reasoning through a local LM Studio server instead of a cloud API.
HERMES_EXTERNAL_PROVIDER=

# ── Notifications — Telegram ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── TradingView webhook signals (optional) ────────────────────
SIGNAL_WEBHOOK_SECRET=change-me
SIGNAL_WEBHOOK_PORT=9100

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── Status export ─────────────────────────────────────────────
# Directory where the JSON status snapshot is written for external dashboards
# (e.g. Eden OS).  Defaults to {data_dir}/status/ if unset.
# MERCURY_STATUS_EXPORT_DIR=

# ── Eden OS agent mesh (outbound-only client) ─────────────────
# Connects OUT to Eden's device_terminals WebSocket so Eden can query and
# govern Mercury via the trading.* capabilities. Variable names match Eden's
# own agent_runtime/config.py so both repos read as one consistent system.
# OFF BY DEFAULT: keep false while Mercury's execution/broker path is being
# debugged; flip to true when ready to test the agent-mesh wiring.
#
# The Ed25519 identity keypair is NOT stored here — it is generated on first
# connect and persisted at {data_dir}/eden/keys/<agent_id>_key (mirrors
# agent_runtime/config.py's agent_data/keys convention). The new identity
# lands in PENDING on the Eden side and needs one-time owner approval there
# before any command will dispatch; after approval every connection
# authenticates by signing a server nonce (challenge-response).
EDEN_AGENT_ENABLED=false
EDEN_URL=ws://localhost:8765
EDEN_AGENT_ID=mercury_trader
EDEN_AGENT_NAME=Mercury Trader
EDEN_AGENT_RISK_TIER=HIGH

# Optional tuning (defaults shown; names from agent_runtime/config.py):
# EDEN_HEARTBEAT_INTERVAL=30.0
# EDEN_RECONNECT_BASE_DELAY=1.0
# EDEN_RECONNECT_MAX_DELAY=60.0
# EDEN_RECONNECT_BACKOFF_FACTOR=2.0
